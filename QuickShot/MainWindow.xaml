<Window x:Class="QuickShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickShot" Height="500" Width="400"
        Icon="icon.png"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" ShadowDepth="8" BlurRadius="16" Opacity="0.4" Color="#000000"/>
    </Window.Resources>

    <Border Background="{StaticResource DarkBg}" CornerRadius="16" Effect="{StaticResource WindowShadow}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="48" CornerRadius="16,16,0,0" Background="{StaticResource DarkSurface}">
                <Grid>
                    <TextBlock Text="QuickShot" Foreground="{StaticResource TextPrimary}"
                              FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <Button x:Name="SettingsButton" Content="&#x2699;" Width="32" Height="32"
                                Style="{StaticResource ToolButton}" Click="SettingsButton_Click" ToolTip="设置" FontSize="16"/>
                        <Button x:Name="MinimizeButton" Content="_" Width="32" Height="32"
                                Style="{StaticResource ToolButton}" Click="MinimizeButton_Click"/>
                        <Button x:Name="CloseButton" Content="&#x2715;" Width="32" Height="32"
                                Style="{StaticResource ToolButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,32">
                <TextBlock Text="选择截图方式" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,16"/>

                <Button Height="56" Margin="0,0,0,12" Click="RegionCapture_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Background" Value="{StaticResource DarkSurface}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="20,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x25A1;" FontSize="20" Foreground="{StaticResource AccentColor}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="区域截图" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="选择屏幕上的任意区域" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Height="56" Margin="0,0,0,12" Click="WindowCapture_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Background" Value="{StaticResource DarkSurface}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="20,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x25A0;" FontSize="20" Foreground="#4ECDC4" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="窗口截图" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="截取当前活动窗口" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Height="56" Margin="0,0,0,24" Click="FullCapture_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                            <Setter Property="Background" Value="{StaticResource DarkSurface}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="20,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x26F6;" FontSize="20" Foreground="#96CEB4" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="全屏截图" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="截取整个屏幕" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Border Background="{StaticResource DarkSurface}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="快捷键" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="区域截图" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <Border Grid.Column="1" Background="{StaticResource DarkBg}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="HotkeyRegionText" Text="Ctrl + Alt + A" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="窗口截图" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <Border Grid.Column="1" Background="{StaticResource DarkBg}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="HotkeyWindowText" Text="Ctrl + Alt + W" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全屏截图" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                            <Border Grid.Column="1" Background="{StaticResource DarkBg}" CornerRadius="4" Padding="8,4">
                                <TextBlock x:Name="HotkeyFullText" Text="Ctrl + Alt + F" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="v1.0.0" Foreground="{StaticResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
