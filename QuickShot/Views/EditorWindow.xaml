<Window x:Class="QuickShot.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickShot Editor" WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        MinWidth="720" MinHeight="420" KeyDown="Window_KeyDown"
        Icon="../icon.png">
    <Window.Resources>
        <Style x:Key="EditorToolButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E5E5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColorBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D2D2D2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DarkBg}" CornerRadius="12" BorderBrush="#D6D6D6" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Drag Titlebar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Height="44" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                        <!-- Vector Icons -->
                        <ToggleButton x:Name="ToolRect" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="rect" ToolTip="矩形 (R)">
                            <Border Width="12" Height="12" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" BorderThickness="1.5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolEllipse" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="ellipse" ToolTip="椭圆 (O)">
                            <Ellipse Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolArrow" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="arrow" ToolTip="箭头 (A)">
                            <Path Data="M0,6 L12,6 M8,2 L12,6 L8,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolLine" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="line" ToolTip="直线 (L)">
                            <Line X1="0" Y1="6" X2="12" Y2="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolText" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="text" ToolTip="文字 (T)">
                            <TextBlock Text="T" FontSize="13" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToolBlur" Style="{StaticResource EditorToolButton}" Click="Tool_Click" Tag="blur" ToolTip="马赛克/模糊 (B)">
                            <UniformGrid Rows="2" Columns="2" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Opacity="0.8"/>
                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Opacity="0.4"/>
                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Opacity="0.4"/>
                                <Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Opacity="0.8"/>
                            </UniformGrid>
                        </ToggleButton>
                        <Rectangle Width="1" Fill="#D6D6D6" Margin="8,6"/>
                        <Button Content="&#x21B6;" Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTip="撤销" Width="32" Height="32"/>
                        <Button Content="&#x1F5D1;" Style="{StaticResource ToolButton}" Click="DeleteSelected_Click" ToolTip="删除选中" Width="32" Height="32"/>
                        <Rectangle Width="1" Fill="#D6D6D6" Margin="8,6"/>
                        <Button Content="&#x1F4CB;" Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="复制" Width="32" Height="32"/>
                        <Button Content="&#x1F4BE;" Style="{StaticResource ToolButton}" Click="Save_Click" MouseRightButtonUp="Save_MouseRightButtonUp" ToolTip="左键：自动保存到默认路径；右键：另存为..." Width="32" Height="32"/>
                        <Button Content="&#x1F4CC;" Style="{StaticResource ToolButton}" Click="Pin_Click" ToolTip="贴图" Width="32" Height="32"/>
                        <Button Content="🔤" Style="{StaticResource ToolButton}" Click="Ocr_Click" ToolTip="文字识别 (OCR)" Width="32" Height="32"/>
                        <Rectangle Width="1" Fill="#D6D6D6" Margin="8,6"/>
                        <Button Content="&#x2699;" Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="设置" Width="32" Height="32"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Click="Close_Click" Width="32" Height="32" Margin="0,0,6,0"/>
                </Grid>
            </Border>

            <!-- Image Workspace -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="#E2E2E2" Padding="20" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Canvas x:Name="EditorCanvas" Background="Transparent"
                            MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp"
                            KeyDown="Canvas_KeyDown" Focusable="True"
                            Cursor="Cross">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                        </Canvas.LayoutTransform>
                        <Image x:Name="ScreenshotImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- Selection Adorner Container -->
                        <Canvas x:Name="SelectionAdorner" Visibility="Collapsed" Panel.ZIndex="999" RenderTransformOrigin="0.5,0.5">
                            <Rectangle x:Name="SelectionIndicator" Stroke="#0067C0" StrokeThickness="1.5" Fill="Transparent"
                                       StrokeDashArray="3 3" Width="{Binding Width, ElementName=SelectionAdorner}" Height="{Binding Height, ElementName=SelectionAdorner}"/>
                            
                            <!-- Drag/Move Handle -->
                            <Border x:Name="DragHandle" Width="18" Height="18" Background="#0067C0" CornerRadius="9"
                                    Cursor="SizeAll" MouseDown="DragHandle_MouseDown" MouseMove="DragHandle_MouseMove" MouseUp="DragHandle_MouseUp"
                                    ToolTip="拖拽移动">
                                <TextBlock Text="✛" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>

                            <!-- Resize Handle -->
                            <Border x:Name="ResizeHandle" Width="12" Height="12" Background="#0067C0" BorderBrush="White" BorderThickness="1.5" CornerRadius="6"
                                    Cursor="SizeNWSE" MouseDown="ResizeHandle_MouseDown" MouseMove="ResizeHandle_MouseMove" MouseUp="ResizeHandle_MouseUp"
                                    ToolTip="调整大小"/>

                            <!-- Rotate Handle -->
                            <Border x:Name="RotateHandle" Width="12" Height="12" Background="#4CAF50" BorderBrush="White" BorderThickness="1.5" CornerRadius="6"
                                    Cursor="Hand" MouseDown="RotateHandle_MouseDown" MouseMove="RotateHandle_MouseMove" MouseUp="RotateHandle_MouseUp"
                                    ToolTip="旋转"/>
                        </Canvas>
                    </Canvas>
                </ScrollViewer>

                <!-- Floating Property Popup in Top-Right Corner of Image Area -->
                <Border x:Name="FloatingPropertyPanel" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,16,0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="10,8" Visibility="Collapsed" Panel.ZIndex="1000">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.18" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">
                        <!-- Stroke Property Row -->
                        <StackPanel x:Name="StrokePropertyRow" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="描边" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FF6B35" Click="Color_Click" Tag="#FF6B35"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FF0000" Click="Color_Click" Tag="#FF0000"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#00FF00" Click="Color_Click" Tag="#00FF00"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#0000FF" Click="Color_Click" Tag="#0000FF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FFFF00" Click="Color_Click" Tag="#FFFF00"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#00FFFF" Click="Color_Click" Tag="#00FFFF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FF00FF" Click="Color_Click" Tag="#FF00FF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FFFFFF" Click="Color_Click" Tag="#FFFFFF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#000000" Click="Color_Click" Tag="#000000"/>
                            <Button x:Name="ActiveColorBtn" Style="{StaticResource ColorBtn}" Background="#FF6B35" Margin="6,0,0,0" BorderBrush="#202020"/>
                            <Rectangle Width="1" Fill="#E0E0E0" Margin="10,2"/>
                            <TextBlock Text="粗细" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" Value="2" Width="80" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Foreground="{StaticResource AccentColor}"/>
                            <TextBlock Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:F0}px}" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Fill Property Row (For Rect, Ellipse) -->
                        <StackPanel x:Name="FillPropertyRow" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="填充" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FF6B35" Click="FillColor_Click" Tag="#FF6B35"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FF0000" Click="FillColor_Click" Tag="#FF0000"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#00FF00" Click="FillColor_Click" Tag="#00FF00"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#0000FF" Click="FillColor_Click" Tag="#0000FF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#FFFFFF" Click="FillColor_Click" Tag="#FFFFFF"/>
                            <Button Style="{StaticResource ColorBtn}" Background="#000000" Click="FillColor_Click" Tag="#000000"/>
                            <Button Style="{StaticResource ColorBtn}" Background="Transparent" BorderBrush="#666" Click="FillColor_Click" Tag="Transparent" ToolTip="无填充"/>
                            <Button x:Name="ActiveFillBtn" Style="{StaticResource ColorBtn}" Background="Transparent" Margin="6,0,0,0" BorderBrush="Gray"/>
                            <Rectangle Width="1" Fill="#E0E0E0" Margin="10,2"/>
                            <TextBlock Text="透明度" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="FillAlphaSlider" Minimum="0" Maximum="255" Value="0" Width="80" VerticalAlignment="Center"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Foreground="{StaticResource AccentColor}"/>
                            <TextBlock Text="{Binding Value, ElementName=FillAlphaSlider, StringFormat={}{0:F0}/255}" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#EAEAEA" Height="32" CornerRadius="0,0,11,11">
                <Grid Margin="12,0">
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="11"
                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ZoomOutBtn" Content="-" Width="20" Height="20" Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="缩小 (滚轮向下)"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0" Cursor="Hand" MouseLeftButtonDown="ZoomReset_Click" ToolTip="点击恢复 100% (Ctrl+0)"/>
                        <Button x:Name="ZoomInBtn" Content="+" Width="20" Height="20" Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="放大 (滚轮向上)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
