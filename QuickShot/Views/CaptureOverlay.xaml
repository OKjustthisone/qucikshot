<Window x:Class="QuickShot.Views.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Cursor="Cross" Topmost="True" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Canvas x:Name="OverlayCanvas">
        <Image x:Name="ScreenImage" Stretch="None"/>

        <Rectangle x:Name="DimmerTop" Fill="#80000000"/>
        <Rectangle x:Name="DimmerBottom" Fill="#80000000"/>
        <Rectangle x:Name="DimmerLeft" Fill="#80000000"/>
        <Rectangle x:Name="DimmerRight" Fill="#80000000"/>

        <Rectangle x:Name="WindowHighlight" Stroke="#00BCD4" StrokeThickness="3" Fill="Transparent" Visibility="Collapsed"
                   StrokeDashArray="4 2"/>

        <Rectangle x:Name="SelectionBorder" Stroke="#FF6B35" StrokeThickness="2" Fill="Transparent" Visibility="Collapsed"/>

        <Border x:Name="InfoPanel" Background="#1E1E1E" CornerRadius="8" Padding="10,6" Visibility="Collapsed" Panel.ZIndex="100">
            <TextBlock x:Name="InfoText" Foreground="White" FontSize="11" FontFamily="Consolas"/>
        </Border>

        <Border x:Name="ColorPreview" Width="44" Height="44" CornerRadius="22"
                BorderThickness="3" BorderBrush="White"
                Visibility="Collapsed" Panel.ZIndex="100">
            <Rectangle x:Name="ColorFill" Fill="Red" RadiusX="19" RadiusY="19"/>
        </Border>

        <TextBlock x:Name="TipText" Text="单击选中窗口 / 拖动选择区域 / ESC 取消" Foreground="#CCCCCC" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="100"/>
    </Canvas>
</Window>