<Window x:Class="QuickShot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="480"
        Icon="../icon.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" ShadowDepth="8" BlurRadius="16" Opacity="0.15" Color="#000000"/>
    </Window.Resources>
    
    <Border Background="{StaticResource DarkBg}" CornerRadius="16" Margin="10" BorderThickness="1" BorderBrush="#E5E5E5" Effect="{StaticResource WindowShadow}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="28" Height="28" Style="{StaticResource ToolButton}" Click="Cancel_Click" FontSize="12"/>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Vertical">
                    <!-- General Settings Card -->
                    <Border Background="{StaticResource DarkSurface}" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5E5" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="常规" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" FontSize="13"/>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="随 Windows 开机启动" Foreground="{StaticResource TextPrimary}" Margin="0,6"/>
                            <CheckBox x:Name="AutoCopyCheck" Content="自动复制截图到剪贴板" Foreground="{StaticResource TextPrimary}" Margin="0,6"/>
                            <CheckBox x:Name="AutoSaveCheck" Content="自动保存截图到默认路径" Foreground="{StaticResource TextPrimary}" Margin="0,6"/>
                        </StackPanel>
                    </Border>

                    <!-- Save Path Card -->
                    <Border Background="{StaticResource DarkSurface}" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5E5" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="保存路径" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" FontSize="13"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SavePathBox" Grid.Column="0" Background="#FFFFFF" Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="1" BorderBrush="#D1D1D1" Padding="10,6" FontSize="12" Height="32" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Style="{StaticResource ActionButton}" Height="32" Click="Browse_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hotkey Settings Card -->
                    <Border Background="{StaticResource DarkSurface}" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5E5" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="快捷键" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" FontSize="13"/>
                            
                            <TextBlock Text="区域截图快捷键" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,2"/>
                            <TextBox x:Name="HotkeyRegionBox" Background="#FFFFFF" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#D1D1D1" Padding="10,6" FontSize="13" Height="32"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>
                            
                            <TextBlock Text="窗口截图快捷键" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,2"/>
                            <TextBox x:Name="HotkeyWindowBox" Background="#FFFFFF" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#D1D1D1" Padding="10,6" FontSize="13" Height="32"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>
                            
                            <TextBlock Text="全屏截图快捷键" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,2"/>
                            <TextBox x:Name="HotkeyFullBox" Background="#FFFFFF" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#D1D1D1" Padding="10,6" FontSize="13" Height="32"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown" Margin="0,0,0,8"/>

                            <TextBlock Text="OCR 文字识别快捷键" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,2"/>
                            <TextBox x:Name="HotkeyOcrBox" Background="#FFFFFF" Foreground="{StaticResource TextPrimary}"
                                     BorderThickness="1" BorderBrush="#D1D1D1" Padding="10,6" FontSize="13" Height="32"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                            
                            <TextBlock Text="提示：选中输入框，直接在键盘上按下组合键即可设置。按 ESC 或 Backspace 可清除快捷键。" 
                                       Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Properties Card -->
                    <Border Background="{StaticResource DarkSurface}" CornerRadius="8" BorderThickness="1" BorderBrush="#E5E5E5" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="截图与标注默认参数" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" FontSize="13"/>
                            
                            <!-- Font Size -->
                            <TextBlock Text="文本标注默认字号" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FontSizeSlider" Grid.Column="0" Minimum="10" Maximum="48" Value="16" TickFrequency="2"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:F0}px}" 
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Mosaic Size -->
                            <TextBlock Text="打码马赛克大小" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,10,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="MosaicSlider" Grid.Column="0" Minimum="5" Maximum="50" Value="15" TickFrequency="5"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=MosaicSlider, StringFormat={}{0:F0}px}" 
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Fill Opacity -->
                            <TextBlock Text="画笔填充色透明度" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,10,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="FillAlphaSlider" Grid.Column="0" Minimum="0" Maximum="255" Value="30" TickFrequency="5"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=FillAlphaSlider, StringFormat={}{0:F0}/255}" 
                                           Foreground="{StaticResource TextPrimary}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Padding="16,8" Margin="0,0,8,0" Background="Transparent" Foreground="{StaticResource TextPrimary}"
                        BorderThickness="1" BorderBrush="#CCCCCC" Height="34" Click="Cancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="保存" Padding="16,8" Style="{StaticResource ActionButton}" Height="34" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>